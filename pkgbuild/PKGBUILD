pkgname=lucidlight
pkgver=0.3.2
pkgrel=1
pkgdesc='Serial monitor, terminal, and test scripting for the desktop'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./build.sh
}

package() {
  cd "$startdir/.."
  install -Dm755 build/lucidlight "$pkgdir/usr/bin/lucidlight"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/lucidlight.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/lucidlight.svg"
  install -Dm644 "$startdir/lucidlight.desktop" "$pkgdir/usr/share/applications/lucidlight.desktop"
  install -Dm644 "$startdir/../docs/lucidlight.1" "$pkgdir/usr/share/man/man1/lucidlight.1"
}
